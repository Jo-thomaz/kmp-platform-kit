{
  "$schema": "https://tr.designtokens.org/format/",
  "primitive": {
    "color": {
      "brand500": { "$type": "color", "$value": "#2563EB" },
      "brand400": { "$type": "color", "$value": "#60A5FA" },
      "neutral50": { "$type": "color", "$value": "#F8FAFC" },
      "neutral100": { "$type": "color", "$value": "#F1F5F9" },
      "neutral200": { "$type": "color", "$value": "#E2E8F0" },
      "neutral400": { "$type": "color", "$value": "#94A3B8" },
      "neutral600": { "$type": "color", "$value": "#475569" },
      "neutral800": { "$type": "color", "$value": "#1E293B" },
      "neutral900": { "$type": "color", "$value": "#0F172A" },
      "neutral950": { "$type": "color", "$value": "#020617" },
      "red500": { "$type": "color", "$value": "#DC2626" },
      "red400": { "$type": "color", "$value": "#F87171" },
      "green500": { "$type": "color", "$value": "#16A34A" },
      "green400": { "$type": "color", "$value": "#4ADE80" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" }
    },
    "spacing": {
      "xs": { "$type": "dimension", "$value": "4dp" },
      "sm": { "$type": "dimension", "$value": "8dp" },
      "md": { "$type": "dimension", "$value": "16dp" },
      "lg": { "$type": "dimension", "$value": "24dp" },
      "xl": { "$type": "dimension", "$value": "32dp" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "6dp" },
      "md": { "$type": "dimension", "$value": "12dp" },
      "lg": { "$type": "dimension", "$value": "20dp" },
      "full": { "$type": "dimension", "$value": "999dp" }
    },
    "elevation": {
      "none": { "$type": "dimension", "$value": "0dp" },
      "low": { "$type": "dimension", "$value": "2dp" },
      "medium": { "$type": "dimension", "$value": "6dp" },
      "high": { "$type": "dimension", "$value": "12dp" }
    },
    "typography": {
      "headingLarge": {
        "$type": "typography",
        "$value": { "fontSize": "28sp", "lineHeight": "36sp", "fontWeight": 700 }
      },
      "titleMedium": {
        "$type": "typography",
        "$value": { "fontSize": "18sp", "lineHeight": "24sp", "fontWeight": 600 }
      },
      "bodyMedium": {
        "$type": "typography",
        "$value": { "fontSize": "16sp", "lineHeight": "22sp", "fontWeight": 400 }
      },
      "labelSmall": {
        "$type": "typography",
        "$value": { "fontSize": "12sp", "lineHeight": "16sp", "fontWeight": 500 }
      }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "normal": { "$type": "duration", "$value": "250ms" },
      "slow": { "$type": "duration", "$value": "400ms" }
    }
  },
  "semantic": {
    "color": {
      "backgroundCanvas": {
        "$type": "color",
        "$value": { "light": "{primitive.color.neutral50}", "dark": "{primitive.color.neutral950}" }
      },
      "backgroundSurface": {
        "$type": "color",
        "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.neutral900}" }
      },
      "backgroundElevated": {
        "$type": "color",
        "$value": { "light": "{primitive.color.neutral100}", "dark": "{primitive.color.neutral800}" }
      },
      "textPrimary": {
        "$type": "color",
        "$value": { "light": "{primitive.color.neutral900}", "dark": "{primitive.color.neutral50}" }
      },
      "textSecondary": {
        "$type": "color",
        "$value": { "light": "{primitive.color.neutral600}", "dark": "{primitive.color.neutral400}" }
      },
      "actionPrimary": {
        "$type": "color",
        "$value": { "light": "{primitive.color.brand500}", "dark": "{primitive.color.brand400}" }
      },
      "actionOnPrimary": {
        "$type": "color",
        "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.neutral950}" }
      },
      "statusError": {
        "$type": "color",
        "$value": { "light": "{primitive.color.red500}", "dark": "{primitive.color.red400}" }
      },
      "statusSuccess": {
        "$type": "color",
        "$value": { "light": "{primitive.color.green500}", "dark": "{primitive.color.green400}" }
      },
      "borderSubtle": {
        "$type": "color",
        "$value": { "light": "{primitive.color.neutral200}", "dark": "{primitive.color.neutral800}" }
      }
    },
    "spacing": {
      "screenPadding": { "$type": "dimension", "$value": "{primitive.spacing.md}" },
      "cardPadding": { "$type": "dimension", "$value": "{primitive.spacing.md}" },
      "stackGap": { "$type": "dimension", "$value": "{primitive.spacing.sm}" },
      "sectionGap": { "$type": "dimension", "$value": "{primitive.spacing.lg}" }
    },
    "radius": {
      "card": { "$type": "dimension", "$value": "{primitive.radius.md}" },
      "button": { "$type": "dimension", "$value": "{primitive.radius.sm}" },
      "pill": { "$type": "dimension", "$value": "{primitive.radius.full}" }
    },
    "elevation": {
      "card": { "$type": "dimension", "$value": "{primitive.elevation.low}" },
      "modal": { "$type": "dimension", "$value": "{primitive.elevation.high}" }
    },
    "typography": {
      "screenTitle": { "$type": "typography", "$value": "{primitive.typography.headingLarge}" },
      "cardTitle": { "$type": "typography", "$value": "{primitive.typography.titleMedium}" },
      "body": { "$type": "typography", "$value": "{primitive.typography.bodyMedium}" },
      "caption": { "$type": "typography", "$value": "{primitive.typography.labelSmall}" }
    },
    "motion": {
      "quick": { "$type": "duration", "$value": "{primitive.motion.fast}" },
      "standard": { "$type": "duration", "$value": "{primitive.motion.normal}" }
    }
  }
}
